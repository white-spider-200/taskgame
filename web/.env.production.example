# Copy to web/.env.production on the server and fill in real values.
# Keep the SQLite file outside the repo so `git pull` never touches it.
DATABASE_URL="file:/home/server/data/taskgame/prod.db"
SESSION_SECRET="replace-with-a-long-random-string"
# Set to "true" only once the app is served over HTTPS (e.g. behind an nginx/TLS reverse proxy).
COOKIE_SECURE="false"
