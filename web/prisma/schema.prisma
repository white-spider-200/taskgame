generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  initial      String
  color        String       @default("#1FB6A6")
  avatarUrl    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  ownedTasks   Task[]       @relation("TaskOwner")
  ratingsGiven Rating[]     @relation("RatingsGiven")
  resetTokens  PasswordResetToken[]
  recurringTasks RecurringTask[] @relation("RecurringOwner")

  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Team {
  id          String       @id @default(cuid())
  name        String
  inviteCode  String       @unique @default(cuid())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  tasks       Task[]
  recurringTasks RecurringTask[]
}

model Membership {
  id         String   @id @default(cuid())
  role       String   @default("member")
  basePoints Int      @default(0)
  blocked    Boolean  @default(false)
  userId     String
  teamId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
  @@index([userId])
}

model Task {
  id         String    @id @default(cuid())
  title      String
  desc       String    @default("")
  category   String
  status     String    @default("running")
  startedAt  DateTime  @default(now())
  elapsedMs  Int?
  completedAt DateTime?
  teamId     String
  ownerId    String
  recurringId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  team       Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  owner      User         @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  recurring  RecurringTask? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  ratings    Rating[]
  submission Submission?

  @@index([teamId, status])
  @@index([ownerId])
  @@index([recurringId])
}

// A rule that auto-creates a Task on a schedule. Instances are materialized
// lazily (see lib/recurring.ts) — no external cron needed.
model RecurringTask {
  id        String    @id @default(cuid())
  title     String
  desc      String    @default("")
  category  String
  freq      String    @default("daily") // daily | weekly | monthly
  weekdays  String    @default("")      // CSV of 0-6 (Sun-Sat), weekly only
  monthDay  Int       @default(1)       // 1-31, monthly only (clamped per month)
  hour      Int       @default(9)       // server-local time of day
  minute    Int       @default(0)
  active    Boolean   @default(true)
  lastRunAt DateTime?                   // last occurrence already materialized
  teamId    String
  ownerId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  owner     User      @relation("RecurringOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([teamId, active])
  @@index([ownerId])
}

model Submission {
  id         String           @id @default(cuid())
  taskId     String           @unique
  type       String
  text       String           @default("")
  textFormat String           @default("auto")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  task       Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  files      SubmissionFile[]
}

model SubmissionFile {
  id           String     @id @default(cuid())
  submissionId String
  url          String
  name         String
  kind         String
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model Rating {
  id        String   @id @default(cuid())
  stars     Int
  taskId    String
  raterId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  rater     User     @relation("RatingsGiven", fields: [raterId], references: [id], onDelete: Cascade)

  @@unique([taskId, raterId])
  @@index([raterId])
  @@index([taskId])
}
